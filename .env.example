# ─────────────────────────────────────────────────────────────
# SmartBus Production Environment Template (.env.example)
# Do NOT place real secrets in this file.
# ─────────────────────────────────────────────────────────────

# =============================================================
# 1. Flutter build-time configuration
# Injected during build via --dart-define or Vercel Environment Variables
# =============================================================
API_BASE_URL=https://your-smartbus-api.example.com
DEMO_MODE=false

# =============================================================
# 2. BACKEND (Render Web Service / Docker) Environment Variables
# Configure these in Render Dashboard -> Environment
# =============================================================
PORT=8080
OSRM_BASE_URL=https://router.project-osrm.org

# PostgreSQL connection. Use a managed PostgreSQL URI in production.
DATABASE_URL=jdbc:postgresql://localhost:5432/smartbus_db
DATABASE_USERNAME=smartbus_user
DATABASE_PASSWORD=replace-this-password

# Application Security:
# Minimum 256-bit secret string for HS256 JWT signing
JWT_SECRET=your-secure-jwt-signing-secret-at-least-32-chars-long

# CORS Allowed Origins:
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://smartbus-web.vercel.app,https://your-custom-domain.com

# Bootstrap Superadmin Credentials (created on initial launch):
BOOTSTRAP_MANAGER_USERNAME=superadmin
BOOTSTRAP_MANAGER_PASSWORD=your-strong-manager-password

# Bootstrap HOD Credentials (created on initial launch):
BOOTSTRAP_HOD_USERNAME=hod
BOOTSTRAP_HOD_PASSWORD=your-strong-hod-password
